          <div class="p-4 pb-3 bg-gradient-to-br ${s.grad} text-white relative">
            ${s.badge ? `<span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-black/25 backdrop-blur-xs border border-white/20">${escapeHtml(s.badge)}</span>` : ""}
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center text-base font-black shrink-0" dir="ltr">
