    const STORAGE_KEY = "digital_services_orders_v1";
    const state = {
      activeTab: "catalog",
      activeCategory: "all",
      searchQuery: "",
      cart: [],   // [{ key, serviceId, name, mono, grad, plan, activation, qty }]
      orders: [],
      selectedService: null,
      selectedPlan: "",
      selectedActivation: "",
      modalQty: 1,
      lastOrder: null
    };

    try {
      const savedOrders = localStorage.getItem(STORAGE_KEY);
      if (savedOrders) {
        const parsed = JSON.parse(savedOrders);
        if (Array.isArray(parsed)) state.orders = parsed;
      }
    } catch (_) {}

    function persistOrders() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state.orders)); } catch (_) {}
    }

    function escapeHtml(s) {
      return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function showToast(msg) {
      const el = document.getElementById("toastEl");
      el.textContent = msg;
      el.classList.remove("hidden");
      clearTimeout(showToast._t);
      showToast._t = setTimeout(() => el.classList.add("hidden"), 2100);
    }

    function copyTextSafe(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => showToast("تم نسخ تفاصيل الطلب")).catch(() => fallbackCopy(text));
      } else fallbackCopy(text);
    }
    function fallbackCopy(text) {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand("copy"); showToast("تم نسخ تفاصيل الطلب"); } catch (_) {}
      document.body.removeChild(ta);
    }

    function formatOrderText(o) {
      return [
        `طلب اشتراك جديد ${o.code}`,
        `الاسم: ${o.customerName}`,
        `الواتساب: ${o.phone}`,
        o.email ? `إيميل التفعيل: ${o.email}` : "",
        o.notes ? `ملاحظات: ${o.notes}` : "",
        "الخدمات المطلوبة:",
        ...o.items.map(it => `- ${it.name} (${it.plan} • ${it.activation}) × ${it.qty}`)
      ].filter(Boolean).join("\n");
    }

    function updateBadges() {
      const cartQty = state.cart.reduce((s, it) => s + it.qty, 0);
      const cb = document.getElementById("cartBadge");
      cb.textContent = cartQty;
      cb.classList.toggle("hidden", cartQty === 0);

      const ob = document.getElementById("ordersBadge");
      ob.textContent = state.orders.length;
      ob.classList.toggle("hidden", state.orders.length === 0);
    }

    function renderCategoryPills() {
      const counts = { all: SERVICES.length };
      SERVICES.forEach(s => { counts[s.cat] = (counts[s.cat] || 0) + 1; });

      document.getElementById("categoryPills").innerHTML = CATEGORIES.map(c => {
        const active = state.activeCategory === c.id;
        return `
          <button
            type="button"
            data-cat="${c.id}"
            class="cat-pill inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-extrabold border transition whitespace-nowrap ${
              active
                ? "bg-indigo-600 text-white border-indigo-600 shadow-sm"
                : "bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-800 hover:border-indigo-500"
            }"
          >
            <span>${c.label}</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded-full ${active ? "bg-white/20 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400"}">${counts[c.id] || 0}</span>
          </button>
        `;
      }).join("");
    }

    function renderServices() {
      const q = state.searchQuery.trim().toLowerCase();
      const filtered = SERVICES.filter(s => {
        if (state.activeCategory !== "all" && s.cat !== state.activeCategory) return false;
        if (!q) return true;
        return s.name.toLowerCase().includes(q)
          || s.ar.toLowerCase().includes(q)
          || s.desc.toLowerCase().includes(q)
          || (CAT_MAP[s.cat] || "").toLowerCase().includes(q);
      });

      document.getElementById("activeCatTitle").textContent = state.activeCategory === "all" ? "جميع الخدمات" : CAT_MAP[state.activeCategory];
      document.getElementById("visibleCountBadge").textContent = `${filtered.length} خدمة`;
      document.getElementById("resetFilterBtn").classList.toggle("hidden", state.activeCategory === "all" && !q);

      const grid = document.getElementById("servicesGrid");
      const empty = document.getElementById("emptySearch");

      if (filtered.length === 0) {
        grid.innerHTML = "";
        empty.classList.remove("hidden");
        return;
      }

      empty.classList.add("hidden");
      grid.innerHTML = filtered.map(s => `
        <div
          data-service-id="${s.id}"
          class="service-card group bg-white dark:bg-[#111827] rounded-3xl border border-slate-200 dark:border-slate-800 hover:border-indigo-500/60 dark:hover:border-indigo-500/60 shadow-xs hover:shadow-xl hover:shadow-indigo-950/15 overflow-hidden flex flex-col cursor-pointer"
