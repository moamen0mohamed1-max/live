    function renderCart() {
      const empty = document.getElementById("emptyCartState");
      const list = document.getElementById("cartItemsList");
      const checkout = document.getElementById("checkoutCard");
      const clearBtn = document.getElementById("clearCartBtn");

      if (state.cart.length === 0) {
        empty.classList.remove("hidden");
        list.innerHTML = "";
        checkout.classList.add("hidden");
        clearBtn.classList.add("hidden");
        return;
      }

      empty.classList.add("hidden");
      checkout.classList.remove("hidden");
      clearBtn.classList.remove("hidden");

      list.innerHTML = state.cart.map((it, idx) => `
        <div class="py-3.5 flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br ${it.grad} text-white font-black text-xs flex items-center justify-center shrink-0" dir="ltr">
            ${escapeHtml(it.mono)}
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-sm font-black truncate" dir="ltr">${escapeHtml(it.name)}</h4>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold mt-0.5">${escapeHtml(it.plan)} • ${escapeHtml(it.activation)}</p>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <button type="button" data-cdec="${idx}" class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 font-black">-</button>
            <span class="w-6 text-center text-xs font-black">${it.qty}</span>
            <button type="button" data-cinc="${idx}" class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 font-black">+</button>
          </div>
        </div>
      `).join("");
    }

    function renderOrders() {
      const empty = document.getElementById("emptyOrdersState");
      const list = document.getElementById("ordersList");
      if (state.orders.length === 0) {
        empty.classList.remove("hidden");
        list.innerHTML = "";
        return;
      }
      empty.classList.add("hidden");
      list.innerHTML = state.orders.map(o => `
        <article class="bg-white dark:bg-[#111827] rounded-3xl border border-slate-200 dark:border-slate-800 p-4 shadow-xs">
          <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-sm font-black text-indigo-600 dark:text-indigo-400" dir="ltr">${escapeHtml(o.code)}</span>
            <span class="text-[11px] text-slate-400 font-semibold">${escapeHtml(o.createdAt)}</span>
          </div>
          <div class="py-2.5 text-xs space-y-1 text-slate-600 dark:text-slate-300">
            <div><span class="text-slate-400">الاسم: </span><strong>${escapeHtml(o.customerName)}</strong></div>
            <div><span class="text-slate-400">الواتساب: </span><strong dir="ltr">${escapeHtml(o.phone)}</strong></div>
            ${o.email ? `<div><span class="text-slate-400">إيميل التفعيل: </span><strong dir="ltr">${escapeHtml(o.email)}</strong></div>` : ""}
          </div>
          <ul class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-3 space-y-1.5 text-xs mb-3">
            ${o.items.map(it => `<li class="flex items-center justify-between gap-2"><span class="font-bold">${escapeHtml(it.name)} (${escapeHtml(it.plan)})</span><span class="font-black text-indigo-600 dark:text-indigo-400">× ${it.qty}</span></li>`).join("")}
          </ul>
          <button type="button" data-copy-order="${o.id}" class="w-full py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-600 hover:text-white text-xs font-extrabold transition">
            نسخ تفاصيل الطلب
          </button>
        </article>
      `).join("");
    }

    function switchTab(tab) {
      state.activeTab = tab;
      document.getElementById("viewCatalog").classList.toggle("hidden", tab !== "catalog");
      document.getElementById("viewCart").classList.toggle("hidden", tab !== "cart");
      document.getElementById("viewOrders").classList.toggle("hidden", tab !== "orders");

      const showSearch = tab === "catalog";
      document.getElementById("searchWrap").classList.toggle("hidden", !showSearch);
      document.getElementById("catBarWrap").classList.toggle("hidden", !showSearch);

      document.querySelectorAll(".nav-btn").forEach(btn => {
        const active = btn.dataset.tab === tab;
        btn.classList.toggle("text-indigo-600", active);
        btn.classList.toggle("dark:text-indigo-400", active);
        btn.classList.toggle("font-extrabold", active);
        btn.classList.toggle("text-slate-500", !active);
        btn.classList.toggle("dark:text-slate-400", !active);
      });

      if (tab === "catalog") renderServices();
      if (tab === "cart") renderCart();
      if (tab === "orders") renderOrders();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function renderModalSelections() {
      const s = state.selectedService;
      if (!s) return;
      document.getElementById("modalPlanOptions").innerHTML = s.plans.map(pl => {
        const active = state.selectedPlan === pl;
        return `<button type="button" data-pick-plan="${escapeHtml(pl)}" class="py-2 px-2 rounded-xl text-xs font-extrabold border transition ${active ? "bg-indigo-600 text-white border-indigo-600" : "bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 hover:border-indigo-500"}">${escapeHtml(pl)}</button>`;
      }).join("");

      document.getElementById("modalActivationOptions").innerHTML = s.activations.map(ac => {
        const active = state.selectedActivation === ac;
        return `<button type="button" data-pick-act="${escapeHtml(ac)}" class="py-2 px-2 rounded-xl text-xs font-extrabold border transition ${active ? "bg-indigo-600 text-white border-indigo-600" : "bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 hover:border-indigo-500"}">${escapeHtml(ac)}</button>`;
      }).join("");
    }

    function openServiceModal(id) {
      const s = SERVICES.find(x => x.id === id);
      if (!s) return;
      state.selectedService = s;
      state.selectedPlan = s.plans[0];
      state.selectedActivation = s.activations[0];
      state.modalQty = 1;

      document.getElementById("modalHero").className = `relative p-6 text-white bg-gradient-to-br ${s.grad}`;
      document.getElementById("modalBrandBadge").textContent = s.mono;
      document.getElementById("modalCatLabel").textContent = CAT_MAP[s.cat];
      document.getElementById("modalTitle").textContent = s.name;
      document.getElementById("modalSubtitle").textContent = s.ar;
      document.getElementById("modalQtyVal").textContent = "1";
      document.getElementById("modalFeatures").innerHTML = s.features.map(f => `<li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo-500 shrink-0"></span><span>${escapeHtml(f)}</span></li>`).join("");

      renderModalSelections();
      document.getElementById("serviceModal").classList.remove("hidden");
    }

    function closeServiceModal() {
      document.getElementById("serviceModal").classList.add("hidden");
      state.selectedService = null;
    }

    document.addEventListener("DOMContentLoaded", () => {
      updateBadges();
      renderCategoryPills();
      renderServices();
      if (window.lucide) lucide.createIcons();

      // Theme toggle
      document.getElementById("themeToggleBtn").addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");
      });

      // Category pills & hero shortcuts
      document.getElementById("categoryPills").addEventListener("click", (e) => {
        const btn = e.target.closest(".cat-pill");
        if (!btn) return;
        state.activeCategory = btn.dataset.cat;
        renderCategoryPills();
        renderServices();
      });
      document.getElementById("heroAiBtn").addEventListener("click", () => {
        state.activeCategory = "ai";
        renderCategoryPills();
        renderServices();
      });
      document.getElementById("heroDesignBtn").addEventListener("click", () => {
        state.activeCategory = "design";
        renderCategoryPills();
        renderServices();
      });

      // Search
      const searchInput = document.getElementById("searchInput");
      const clearBtn = document.getElementById("clearSearchBtn");
      searchInput.addEventListener("input", () => {
        state.searchQuery = searchInput.value;
        clearBtn.classList.toggle("hidden", !state.searchQuery);
        renderServices();
      });
      clearBtn.addEventListener("click", () => {
        searchInput.value = "";
        state.searchQuery = "";
        clearBtn.classList.add("hidden");
        renderServices();
        searchInput.focus();
      });
      const resetAll = () => {
        state.activeCategory = "all";
        state.searchQuery = "";
        searchInput.value = "";
        clearBtn.classList.add("hidden");
        renderCategoryPills();
        renderServices();
      };
      document.getElementById("resetFilterBtn").addEventListener("click", resetAll);
      document.getElementById("emptyResetBtn").addEventListener("click", resetAll);

      // Service card click
      document.getElementById("servicesGrid").addEventListener("click", (e) => {
        const card = e.target.closest("[data-service-id]");
        if (card) openServiceModal(Number(card.dataset.serviceId));
      });

      // Modal events
      document.getElementById("closeModalBtn").addEventListener("click", closeServiceModal);
      document.getElementById("serviceModal").addEventListener("click", (e) => {
        if (e.target.id === "serviceModal") closeServiceModal();
      });
      document.getElementById("modalPlanOptions").addEventListener("click", (e) => {
        const b = e.target.closest("[data-pick-plan]");
        if (b) { state.selectedPlan = b.dataset.pickPlan; renderModalSelections(); }
      });
      document.getElementById("modalActivationOptions").addEventListener("click", (e) => {
        const b = e.target.closest("[data-pick-act]");
        if (b) { state.selectedActivation = b.dataset.pickAct; renderModalSelections(); }
      });
      document.getElementById("modalQtyMinus").addEventListener("click", () => {
        if (state.modalQty > 1) { state.modalQty--; document.getElementById("modalQtyVal").textContent = state.modalQty; }
      });
      document.getElementById("modalQtyPlus").addEventListener("click", () => {
        state.modalQty++; document.getElementById("modalQtyVal").textContent = state.modalQty;
      });
      document.getElementById("modalAddBtn").addEventListener("click", () => {
        const s = state.selectedService;
        if (!s) return;
        const key = `${s.id}|${state.selectedPlan}|${state.selectedActivation}`;
        const existing = state.cart.find(x => x.key === key);
        if (existing) existing.qty += state.modalQty;
        else state.cart.push({ key, serviceId: s.id, name: s.name, mono: s.mono, grad: s.grad, plan: state.selectedPlan, activation: state.selectedActivation, qty: state.modalQty });
        updateBadges();
        closeServiceModal();
        showToast(`تمت إضافة ${s.name} للسلة`);
      });

      // Cart controls
      document.getElementById("cartItemsList").addEventListener("click", (e) => {
        const inc = e.target.closest("[data-cinc]");
        const dec = e.target.closest("[data-cdec]");
        if (inc) {
          state.cart[Number(inc.dataset.cinc)].qty++;
          updateBadges(); renderCart();
        } else if (dec) {
          const i = Number(dec.dataset.cdec);
          if (state.cart[i].qty <= 1) state.cart.splice(i, 1);
          else state.cart[i].qty--;
          updateBadges(); renderCart();
        }
      });
      document.getElementById("clearCartBtn").addEventListener("click", () => {
        state.cart = [];
        updateBadges(); renderCart();
        showToast("تم تفريغ السلة");
      });
      document.getElementById("goCatalogBtn").addEventListener("click", () => switchTab("catalog"));

      // Checkout submit
      document.getElementById("checkoutForm").addEventListener("submit", (e) => {
        e.preventDefault();
        if (state.cart.length === 0) return;
        const order = {
          id: Date.now(),
          code: `#DS-${1001 + state.orders.length}`,
          customerName: document.getElementById("custName").value.trim(),
          phone: document.getElementById("custPhone").value.trim(),
          email: document.getElementById("custEmail").value.trim(),
          notes: document.getElementById("custNotes").value.trim(),
          items: state.cart.map(it => ({ name: it.name, plan: it.plan, activation: it.activation, qty: it.qty })),
          createdAt: new Date().toLocaleString("ar-EG", { dateStyle: "short", timeStyle: "short" })
        };
        state.orders.unshift(order);
        state.lastOrder = order;
        persistOrders();
        state.cart = [];
        document.getElementById("checkoutForm").reset();
        updateBadges();
        renderCart();
        document.getElementById("successOrderCode").textContent = `رقم الطلب: ${order.code}`;
        document.getElementById("orderSuccessModal").classList.remove("hidden");
      });

      document.getElementById("copySuccessOrderBtn").addEventListener("click", () => {
        if (state.lastOrder) copyTextSafe(formatOrderText(state.lastOrder));
      });
      document.getElementById("closeSuccessModalBtn").addEventListener("click", () => {
        document.getElementById("orderSuccessModal").classList.add("hidden");
        switchTab("catalog");
      });

      // Orders copy
      document.getElementById("ordersList").addEventListener("click", (e) => {
        const b = e.target.closest("[data-copy-order]");
        if (!b) return;
        const o = state.orders.find(x => x.id === Number(b.dataset.copyOrder));
        if (o) copyTextSafe(formatOrderText(o));
      });

      // Bottom nav
      document.querySelectorAll(".nav-btn").forEach(btn => {
        btn.addEventListener("click", () => switchTab(btn.dataset.tab));
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeServiceModal();
          document.getElementById("orderSuccessModal").classList.add("hidden");
        }
      });
    });
  </script>
</body>
</html>
