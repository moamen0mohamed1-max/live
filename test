<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>ديجيتال ستور — اشتراكات البرامج والذكاء الاصطناعي</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script>
    tailwind.config = { darkMode: 'class' };
  </script>
  <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Inter:wght@500;700;800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: 'Cairo', 'Inter', system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
      padding-bottom: 88px;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .service-card {
      transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .service-card:hover {
      transform: translateY(-4px);
    }
    .modal-backdrop { animation: fadeIn 0.16s ease-out; }
    .modal-sheet { animation: slideUp 0.22s ease-out; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideUp { from { opacity: 0; transform: translateY(18px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 dark:bg-[#090d16] dark:text-slate-100 transition-colors duration-200">

  <!-- Sticky Header -->
  <header class="sticky top-0 z-30 bg-white/90 dark:bg-[#0d1321]/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 pt-3 pb-3">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-violet-600 via-indigo-600 to-cyan-500 flex items-center justify-center text-white font-black text-base shadow-lg shadow-indigo-500/25 shrink-0">
            <i data-lucide="zap" class="w-5 h-5"></i>
          </div>
          <div class="min-w-0">
            <h1 class="text-base sm:text-lg font-black leading-tight truncate">ديجيتال ستور</h1>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-tight truncate">اشتراكات أصلية • ذكاء اصطناعي • برامج وتراخيص</p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <span id="serviceCountPill" class="hidden sm:inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold bg-indigo-50 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-500/30">
            21 خدمة
          </span>
          <button
            id="themeToggleBtn"
            type="button"
            aria-label="تبديل المظهر"
            class="w-9 h-9 rounded-xl border border-slate-200 dark:border-slate-700/80 bg-slate-100 dark:bg-slate-800/80 flex items-center justify-center text-slate-700 dark:text-amber-300 hover:border-indigo-500 transition"
          >
            <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
            <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
          </button>
        </div>
      </div>

      <!-- Search Bar -->
      <div id="searchWrap" class="mt-3 relative">
        <span class="absolute inset-y-0 right-3.5 flex items-center text-slate-400 pointer-events-none">
          <i data-lucide="search" class="w-4 h-4"></i>
        </span>
        <input
          id="searchInput"
          type="search"
          autocomplete="off"
          placeholder="ابحث عن خدمة (مثال: Adobe, ChatGPT, Windows, Kaspersky)..."
          class="w-full bg-slate-100 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 focus:border-indigo-500 dark:focus:border-indigo-500 rounded-xl pr-10 pl-9 py-2.5 text-sm placeholder-slate-400 outline-none transition"
        />
        <button id="clearSearchBtn" type="button" aria-label="مسح البحث" class="hidden absolute inset-y-0 left-2.5 my-auto w-7 h-7 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-white transition">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Category Pills -->
      <div id="catBarWrap" class="mt-2.5 -mx-4 px-4 overflow-x-auto no-scrollbar">
        <div id="categoryPills" class="flex items-center gap-2 w-max pb-0.5"></div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 pt-4">

    <!-- VIEW 1: Services Catalog -->
    <section id="viewCatalog" aria-label="الخدمات والاشتراكات">

      <!-- Hero Banner -->
      <div class="mb-5 rounded-3xl bg-gradient-to-l from-indigo-600 via-violet-600 to-fuchsia-600 text-white p-5 sm:p-6 shadow-xl shadow-indigo-900/20 relative overflow-hidden">
        <div class="relative z-10 flex flex-wrap items-center justify-between gap-4">
          <div class="max-w-xl">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 backdrop-blur-xs border border-white/20 text-[11px] font-extrabold mb-2">
              <i data-lucide="shield-check" class="w-3.5 h-3.5 text-amber-300"></i>
              تفعيل رسمي ومضمون طوال مدة الاشتراك
            </div>
            <h2 class="text-lg sm:text-2xl font-black leading-snug">كل أدوات الذكاء الاصطناعي وبرامج التصميم والأعمال في مكان واحد</h2>
            <p class="text-xs sm:text-sm text-indigo-100 mt-1">اختر الباقة والمدة المناسبة لك وأرسل طلبك في ثوانٍ</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button id="heroAiBtn" type="button" class="px-4 py-2.5 rounded-xl bg-white text-indigo-700 hover:bg-indigo-50 text-xs font-black shadow-sm transition">
              أدوات الذكاء الاصطناعي
            </button>
            <button id="heroDesignBtn" type="button" class="px-4 py-2.5 rounded-xl bg-white/15 hover:bg-white/25 text-white border border-white/25 text-xs font-extrabold transition">
              التصميم والمونتاج
            </button>
          </div>
        </div>
      </div>

      <!-- Grid Header -->
      <div class="flex items-center justify-between gap-2 mb-3.5">
        <div class="flex items-center gap-2">
          <h2 id="activeCatTitle" class="text-sm sm:text-base font-black">جميع الخدمات</h2>
          <span id="visibleCountBadge" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300"></span>
        </div>
        <button id="resetFilterBtn" type="button" class="hidden text-xs font-extrabold text-indigo-600 dark:text-indigo-400 hover:underline">
          عرض الكل
        </button>
      </div>

      <!-- Services Grid -->
      <div id="servicesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5 sm:gap-4"></div>

      <!-- Empty Search State -->
      <div id="emptySearch" class="hidden bg-white dark:bg-[#111827] rounded-3xl border border-slate-200 dark:border-slate-800 p-10 text-center mt-4">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-3">
          <i data-lucide="search-x" class="w-7 h-7"></i>
        </div>
        <p class="text-sm font-extrabold">لم نجد خدمة مطابقة لبحثك</p>
        <button id="emptyResetBtn" type="button" class="mt-4 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-extrabold transition">
          عرض جميع الخدمات
        </button>
      </div>
    </section>

    <!-- VIEW 2: Cart & Checkout -->
    <section id="viewCart" class="hidden" aria-label="سلة الطلبات">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
        <div class="lg:col-span-7 bg-white dark:bg-[#111827] rounded-3xl border border-slate-200 dark:border-slate-800 p-5 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-black">سلة الاشتراكات</h2>
            <button id="clearCartBtn" type="button" class="hidden text-xs font-bold text-rose-500 hover:underline">تفريغ السلة</button>
          </div>

          <div id="emptyCartState" class="py-12 px-4 text-center rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-3">
              <i data-lucide="shopping-bag" class="w-7 h-7"></i>
            </div>
            <h3 class="text-sm font-extrabold">سلتك فارغة حالياً</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">اختر الاشتراك أو البرنامج الذي تحتاجه وأضفه للسلة</p>
            <button id="goCatalogBtn" type="button" class="mt-4 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-extrabold transition">
              تصفح الخدمات
            </button>
          </div>

          <div id="cartItemsList" class="divide-y divide-slate-100 dark:divide-slate-800"></div>
        </div>

        <div id="checkoutCard" class="hidden lg:col-span-5 bg-white dark:bg-[#111827] rounded-3xl border border-slate-200 dark:border-slate-800 p-5 shadow-xs h-fit">
          <h3 class="text-base font-black mb-1">إتمام طلب الاشتراك</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">أدخل بياناتك لتفعيل الاشتراك والتواصل معك بالسعر وتفاصيل الدفع</p>
          <form id="checkoutForm" class="space-y-3">
            <div>
              <label for="custName" class="block text-xs font-bold mb-1">الاسم *</label>
              <input id="custName" type="text" required placeholder="مثال: أحمد محمد" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 focus:border-indigo-500 rounded-xl px-3.5 py-2.5 text-sm outline-none" />
            </div>
            <div>
              <label for="custPhone" class="block text-xs font-bold mb-1">رقم الواتساب *</label>
              <input id="custPhone" type="tel" required placeholder="01xxxxxxxxx" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 focus:border-indigo-500 rounded-xl px-3.5 py-2.5 text-sm outline-none" />
            </div>
            <div>
              <label for="custEmail" class="block text-xs font-bold mb-1">البريد الإلكتروني للتفعيل (اختياري)</label>
              <input id="custEmail" type="email" dir="ltr" placeholder="name@email.com" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 focus:border-indigo-500 rounded-xl px-3.5 py-2.5 text-sm text-left outline-none" />
            </div>
            <div>
              <label for="custNotes" class="block text-xs font-bold mb-1">ملاحظات (اختياري)</label>
              <textarea id="custNotes" rows="2" placeholder="أي تفاصيل إضافية..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 focus:border-indigo-500 rounded-xl px-3.5 py-2 text-sm outline-none resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-l from-indigo-600 to-violet-600 hover:opacity-95 text-white text-sm font-black shadow-md shadow-indigo-500/20 transition flex items-center justify-center gap-2">
              <i data-lucide="send" class="w-4 h-4"></i>
              تأكيد وإرسال الطلب
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- VIEW 3: My Orders History -->
    <section id="viewOrders" class="hidden" aria-label="طلباتي">
      <div class="mb-4">
        <h2 class="text-base sm:text-lg font-black">سجل طلباتي</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">تابع جميع طلبات الاشتراكات التي أرسلتها وانسخ تفاصيلها في أي وقت</p>
      </div>
      <div id="emptyOrdersState" class="bg-white dark:bg-[#111827] rounded-3xl border-2 border-dashed border-slate-200 dark:border-slate-800 p-10 text-center">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-3">
          <i data-lucide="receipt-text" class="w-7 h-7"></i>
        </div>
        <h3 class="text-sm font-extrabold">لا توجد طلبات مسجلة بعد</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">عند إرسال أي طلب سيظهر هنا برقم الطلب والتفاصيل الكاملة</p>
      </div>
      <div id="ordersList" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
    </section>

  </main>

  <!-- Service Details & Plan Picker Modal -->
  <div id="serviceModal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-slate-950/70 backdrop-blur-xs modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="bg-white dark:bg-[#111827] w-full sm:max-w-lg rounded-t-3xl sm:rounded-3xl overflow-hidden shadow-2xl border border-slate-200 dark:border-slate-800 modal-sheet">
      <div id="modalHero" class="relative p-6 text-white">
        <button id="closeModalBtn" type="button" aria-label="إغلاق" class="absolute top-4 left-4 w-9 h-9 rounded-full bg-black/25 hover:bg-black/40 flex items-center justify-center text-white transition">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
        <div class="flex items-center gap-3.5">
          <div id="modalBrandBadge" class="w-14 h-14 rounded-2xl bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center text-xl font-black shrink-0" dir="ltr"></div>
          <div class="min-w-0">
            <span id="modalCatLabel" class="inline-block text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-black/20 mb-1"></span>
            <h3 id="modalTitle" class="text-lg font-black leading-tight" dir="ltr"></h3>
            <p id="modalSubtitle" class="text-xs text-white/85 mt-0.5"></p>
          </div>
        </div>
      </div>

      <div class="p-5 space-y-4">
        <!-- Features -->
        <div>
          <h4 class="text-xs font-extrabold text-slate-500 dark:text-slate-400 mb-2">مميزات الاشتراك:</h4>
          <ul id="modalFeatures" class="space-y-1.5 text-xs font-semibold"></ul>
        </div>

        <!-- Duration Picker -->
        <div>
          <h4 class="text-xs font-extrabold text-slate-500 dark:text-slate-400 mb-2">اختر الباقة / المدة:</h4>
          <div id="modalPlanOptions" class="grid grid-cols-3 gap-2"></div>
        </div>

        <!-- Activation Type -->
        <div>
          <h4 class="text-xs font-extrabold text-slate-500 dark:text-slate-400 mb-2">نوع التفعيل:</h4>
          <div id="modalActivationOptions" class="grid grid-cols-2 gap-2"></div>
        </div>

        <!-- Add to Cart CTA -->
        <div class="pt-2 flex items-center gap-2.5">
          <div class="flex items-center border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden bg-slate-50 dark:bg-slate-900">
            <button id="modalQtyMinus" type="button" class="w-10 h-11 flex items-center justify-center font-black hover:bg-slate-200 dark:hover:bg-slate-800 transition">-</button>
            <span id="modalQtyVal" class="w-9 text-center text-sm font-black">1</span>
            <button id="modalQtyPlus" type="button" class="w-10 h-11 flex items-center justify-center font-black hover:bg-slate-200 dark:hover:bg-slate-800 transition">+</button>
          </div>
          <button id="modalAddBtn" type="button" class="flex-1 py-3 rounded-xl bg-gradient-to-l from-indigo-600 to-violet-600 hover:opacity-95 text-white text-sm font-black shadow-md shadow-indigo-500/20 transition flex items-center justify-center gap-2">
            <i data-lucide="shopping-bag" class="w-4 h-4"></i>
            أضف للسلة
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Order Confirmed Modal -->
  <div id="orderSuccessModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-xs modal-backdrop" role="dialog" aria-modal="true">
    <div class="bg-white dark:bg-[#111827] w-full max-w-sm rounded-3xl p-6 text-center shadow-2xl border border-slate-200 dark:border-slate-800 modal-sheet">
      <div class="w-16 h-16 mx-auto rounded-full bg-emerald-500/15 text-emerald-500 flex items-center justify-center mb-3">
        <i data-lucide="check-circle-2" class="w-9 h-9"></i>
      </div>
      <h3 class="text-base font-black">تم تسجيل طلبك بنجاح!</h3>
      <p id="successOrderCode" class="text-sm font-black text-indigo-600 dark:text-indigo-400 mt-1"></p>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">تم حفظ طلبك في قسم "طلباتي" ويمكنك نسخ ملخص الطلب لإرساله مباشرة على واتساب.</p>
      <div class="mt-5 flex flex-col gap-2">
        <button id="copySuccessOrderBtn" type="button" class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold transition flex items-center justify-center gap-1.5">
          <i data-lucide="copy" class="w-4 h-4"></i>
          نسخ تفاصيل الطلب للواتساب
        </button>
        <button id="closeSuccessModalBtn" type="button" class="w-full py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-extrabold transition">
          العودة للخدمات
        </button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toastEl" class="hidden fixed bottom-24 left-1/2 -translate-x-1/2 z-50 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-extrabold px-4 py-2.5 rounded-full shadow-lg"></div>

  <!-- Bottom Navigation -->
  <nav class="fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-[#0d1321]/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800" aria-label="التنقل الرئيسي">
    <div class="max-w-xl mx-auto grid grid-cols-3 h-16">
      <button type="button" data-tab="catalog" class="nav-btn flex flex-col items-center justify-center gap-1 text-indigo-600 dark:text-indigo-400 font-extrabold transition">
        <i data-lucide="layout-grid" class="w-5 h-5"></i>
        <span class="text-[11px]">الخدمات</span>
      </button>
      <button type="button" data-tab="cart" class="nav-btn relative flex flex-col items-center justify-center gap-1 text-slate-500 dark:text-slate-400 font-semibold transition">
        <div class="relative">
          <i data-lucide="shopping-bag" class="w-5 h-5"></i>
          <span id="cartBadge" class="hidden absolute -top-1.5 -left-2.5 min-w-[18px] h-[18px] px-1 rounded-full bg-indigo-600 text-white text-[10px] font-black flex items-center justify-center">0</span>
        </div>
        <span class="text-[11px]">السلة</span>
      </button>
      <button type="button" data-tab="orders" class="nav-btn relative flex flex-col items-center justify-center gap-1 text-slate-500 dark:text-slate-400 font-semibold transition">
        <div class="relative">
          <i data-lucide="receipt-text" class="w-5 h-5"></i>
          <span id="ordersBadge" class="hidden absolute -top-1.5 -left-2.5 min-w-[18px] h-[18px] px-1 rounded-full bg-emerald-600 text-white text-[10px] font-black flex items-center justify-center">0</span>
        </div>
        <span class="text-[11px]">طلباتي</span>
      </button>
    </div>
  </nav>

  <script>
    const CATEGORIES = [
      { id: "all",      label: "الكل",               icon: "layout-grid" },
      { id: "ai",       label: "الذكاء الاصطناعي",   icon: "sparkles" },
      { id: "design",   label: "التصميم والمونتاج",  icon: "palette" },
      { id: "business", label: "الأعمال والإنتاجية", icon: "briefcase" },
      { id: "security", label: "الهندسة والحماية",   icon: "shield" }
    ];
    const CAT_MAP = Object.fromEntries(CATEGORIES.map(c => [c.id, c.label]));

    const SERVICES = [
      // AI Tools (9)
      {
        id: 1, name: "ChatGPT Plus", ar: "شات جي بي تي بلس", cat: "ai", mono: "GPT",
        grad: "from-emerald-600 to-teal-700", badge: "الأكثر طلباً",
        desc: "وصول كامل لأحدث نماذج GPT وتوليد الصور وتحليل الملفات",
        plans: ["شهري", "3 شهور", "سنوي"],
        activations: ["على إيميلك الشخصي", "حساب خاص جاهز"],
        features: ["وصول لأحدث نماذج المحادثة المتقدمة", "تحليل الملفات والصور والبرمجة بسرعة عالية", "توليد صور احترافية مباشرة داخل المحادثة"]
      },
      {
        id: 2, name: "Gemini AI Pro", ar: "جيميني برو من جوجل", cat: "ai", mono: "Gem",
